{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/src/components",
    "utils": "@/src/lib/utils",
    "ui": "@/src/components/ui",
    "lib": "@/src/lib",
    "hooks": "@/src/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@assistant-ui": "https://r.assistant-ui.com/styles/{style}/{name}.json",
    "@cult-ui": "https://www.cult-ui.com/r/{name}.json"
  }
}
