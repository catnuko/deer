# 复制为 .env.local 后填入真实值。.env.local 不会被提交。
#
# 本地开发用的默认 AI provider：配置后无需在设置面板手动填写即可使用。
# 在设置面板保存过的配置优先级更高。
# 生产环境不要设置这些变量。

NEXT_PUBLIC_DEER_DEFAULT_PROVIDER=custom
NEXT_PUBLIC_DEER_DEFAULT_BASE_URL=http://127.0.0.1:3425/v1
NEXT_PUBLIC_DEER_DEFAULT_API_KEY=
NEXT_PUBLIC_DEER_DEFAULT_MODEL=group/qoder
